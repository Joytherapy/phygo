# PHYGO environment variables — names only, never commit real values.
# Copy to .env.local for local development; set the same names in Vercel.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — every route using it must authorize the caller.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---------------------------------------------------------------------
# Server-only.
OPENAI_API_KEY=

# --- Admin access (lib/auth/adminServer.ts) ---------------------------------
# Comma-separated emails of accounts allowed to use admin routes and pages
# (events-admin, library-admin, science-admin, science batch jobs).
# The account's email must be confirmed. Empty = nobody is an admin.
PHYGO_ADMIN_EMAILS=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/*.
# Also accepted by admin routes so the cron job can call the science batch jobs.
CRON_SECRET=
# Optional: bearer token for local maintenance scripts (seed-*.js, link-*.js,
# tag-zones.js) that call /api/library/admin. Send it as
# `Authorization: Bearer $PHYGO_ADMIN_API_TOKEN`.
PHYGO_ADMIN_API_TOKEN=

# --- Optional integrations --------------------------------------------------
# Daily.co video calls (app/api/video-call/create-room).
DAILY_API_KEY=
# Workspace document conversion binaries (lib/workspace/convertToPdf.ts).
SOFFICE_PATH=
EBOOK_CONVERT_PATH=

# Professional verification transition (server-side, optional).
# Clinical AI features and video calls need a professional verified by a
# PHYGO administrator. During the rollout, accounts that existed before it can
# keep temporary access, but ONLY if listed here explicitly by account id, and
# only until the end date (ISO 8601, at most 90 days ahead). Leave both empty
# when no transition is running. See docs/security/professional-verification-rollout.md.
PROFESSIONAL_TRANSITION_ACCOUNTS=
PROFESSIONAL_TRANSITION_UNTIL=
